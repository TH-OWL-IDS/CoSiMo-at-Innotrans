# CoSiMo AI stack on the GX10 — copy to .env
# The bearer CoSiMo's realtime sends (LLM_API_KEY there). Generate: openssl rand -hex 24
VLLM_API_KEY=
# CoSiMo's OWN tailnet (not the box's host Tailscale): a single-use, non-
# ephemeral auth key tagged tag:cosimo-gx10, from login.tailscale.com/admin.
TS_AUTHKEY=
TS_HOSTNAME=cosimo-gx10
TS_TAG=tag:cosimo-gx10
# Stock Qwen3 27B, NVFP4. Swap for a bake-off (e.g. a Mistral Small NVFP4).
MODEL=unsloth/Qwen3.8-27B-NVFP4
# Share of unified memory vLLM may claim. MTP speculative decoding needs the
# extra headroom for its draft head + KV cache (0.24 failed the KV check).
GPU_MEM=0.29
