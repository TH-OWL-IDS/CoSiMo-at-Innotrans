# CoSiMo AI stack on the GX10 — copy to .env
# The bearer CoSiMo's realtime sends (LLM_API_KEY there). Generate: openssl rand -hex 24
VLLM_API_KEY=
# The GX10's tailnet IP (tailscale ip -4). The service binds to it only.
TAILNET_IP=100.90.216.127
# Stock Qwen3 27B, NVFP4. Swap for a bake-off (e.g. a Mistral Small NVFP4).
MODEL=unsloth/Qwen3.8-27B-NVFP4
# Share of unified memory vLLM may claim (0.24 ≈ 29 GB next to the other tenants).
GPU_MEM=0.24
