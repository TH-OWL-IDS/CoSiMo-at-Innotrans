# ─── Database (shared Postgres) ───────────────────────────────
POSTGRES_USER=cosimo
POSTGRES_PASSWORD=cosimo_dev
POSTGRES_DB=cosimo
# Connection string used by both cms and realtime
DATABASE_URI=postgres://cosimo:cosimo_dev@postgres:5432/cosimo

# ─── Payload CMS ──────────────────────────────────────────────
PAYLOAD_SECRET=change-me-in-prod
CMS_PORT=3001
# Public URL the iPads/host console reach the CMS+PWA at
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Public URL the PWA opens a WebSocket to (realtime service)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# ─── Realtime / Agent service ─────────────────────────────────
REALTIME_PORT=4000
# Anthropic (Claude) — cloud LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# LLM endpoint routing (defaults; the operator-config global in the CMS can
# override provider/baseUrl/model live). anthropic | openai-compatible
LLM_PROVIDER=anthropic
# For openai-compatible (DGX/vLLM/TGI), e.g. http://dgx.example.org:8000/v1
LLM_BASE_URL=
# Bearer token for the openai-compatible endpoint, if it needs one
LLM_API_KEY=
# How realtime writes session records back to Payload (REST API)
PAYLOAD_INTERNAL_URL=http://cms:3001
PAYLOAD_API_KEY=
# Shared secret authorizing realtime -> CMS writes to the sessions collection.
# Must match on both services. Change for production.
PAYLOAD_INTERNAL_KEY=change-me-internal

# ─── Speech (optional — leave blank to use the browser's Web Speech) ──
# Server STT (Deepgram). Blank → iPads use the browser's speech recognition.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_BASE_URL=https://api.deepgram.com
# Server TTS (ElevenLabs). Both must be set; blank → iPads speak via the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voice model: eleven_flash_v2_5 (fastest), eleven_turbo_v2_5 (balanced),
# eleven_multilingual_v2 (best quality, slow).
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ─── Production (VPS) ─────────────────────────────────────────
# Domain Caddy serves + gets TLS for (docker-compose.prod.yml). The native
# kiosk app on the iPads points at https://$COSIMO_DOMAIN.
COSIMO_DOMAIN=cosimo.homannjohannes.de
# Days of nightly pg_dump backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# ─── Resilience / health ──────────────────────────────────────
# Connectivity probe; network down → CoSiMo auto-switches to offline canned mode.
HEALTH_PING_URL=https://www.gstatic.com/generate_204
HEALTH_INTERVAL_MS=15000

# ─── Cabin hardware ───────────────────────────────────────────
# Shelly relay on the local LAN (Phase 2). Leave blank to use the fake driver.
SHELLY_BASE_URL=
LIGHT_DRIVER=fake
