# ─── Database (shared Postgres) ───────────────────────────────
POSTGRES_USER=cosimo
POSTGRES_PASSWORD=cosimo_dev
POSTGRES_DB=cosimo
# Connection string used by both cms and realtime
DATABASE_URI=postgres://cosimo:cosimo_dev@postgres:5432/cosimo

# ─── Payload CMS ──────────────────────────────────────────────
PAYLOAD_SECRET=change-me-in-prod
CMS_PORT=6100
# Public URL the iPads/host console reach the CMS+PWA at
NEXT_PUBLIC_SERVER_URL=http://localhost:6100
# Public URL the host console / emulator open their WebSocket to — baked
# into its static bundle at build time (local compose only; prod uses COSIMO_WS_DOMAIN).
REALTIME_PUBLIC_URL=http://localhost:6101

# ─── Realtime / Agent service ─────────────────────────────────
REALTIME_PORT=6101
# Host console + seat emulator containers (optional; the dev servers are the fast path).
CONSOLE_PORT=6102
EMULATOR_PORT=6103
JOURNEY_PORT=6104
# Anthropic (Claude) — cloud LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# LLM endpoint routing (defaults; the operator-config global in the CMS can
# override provider/baseUrl/model live). anthropic | openai-compatible
LLM_PROVIDER=anthropic
# For openai-compatible (DGX/vLLM/TGI), e.g. http://dgx.example.org:8000/v1
LLM_BASE_URL=
# Bearer token for the openai-compatible endpoint, if it needs one
LLM_API_KEY=
# How realtime writes session records back to Payload (REST API)
PAYLOAD_INTERNAL_URL=http://cms:6100
PAYLOAD_API_KEY=
# Shared secret authorizing realtime -> CMS writes to the sessions collection.
# Must match on both services. Change for production.
PAYLOAD_INTERNAL_KEY=change-me-internal

# ─── Speech (optional — leave blank to use the browser's Web Speech) ──
# Server STT (Deepgram). Blank → iPads use the browser's speech recognition.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_BASE_URL=https://api.deepgram.com
# Server TTS (ElevenLabs). Both must be set; blank → iPads speak via the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voice model: eleven_flash_v2_5 (fastest), eleven_turbo_v2_5 (balanced),
# eleven_multilingual_v2 (best quality, slow).
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ─── Production (VPS) ─────────────────────────────────────────
# Public hostname for the CMS (admin + /host console).
#   - Caddy variant  (docker-compose.prod.yml):        also the realtime host
#     (single origin, path-split); iPads point at https://$COSIMO_DOMAIN.
#   - Cloudflare variant (docker-compose.cloudflared.yml): CMS host only;
#     realtime is a separate host, COSIMO_WS_DOMAIN below.
COSIMO_DOMAIN=cosimo.homannjohannes.de
# Cloudflare variant only: the realtime (WebSocket) hostname the iPads and the
# /host console connect their socket to.
COSIMO_WS_DOMAIN=ws-cosimo.homannjohannes.de
# Cloudflare variant only: the host console and the seat emulator hostnames.
# Default to host-/seat-$COSIMO_DOMAIN if unset.
COSIMO_CONSOLE_DOMAIN=console-cosimo.homannjohannes.de
COSIMO_SEAT_DOMAIN=seat-cosimo.homannjohannes.de
COSIMO_JOURNEY_DOMAIN=journey-cosimo.homannjohannes.de
# Cloudflare variant only: localhost ports the tunnel points at (pick free ones
# on the box — the local 61xx ports may be taken by other apps).
COSIMO_CMS_PORT=6220
COSIMO_RT_PORT=6221
COSIMO_CONSOLE_PORT=6222
COSIMO_EMU_PORT=6223
COSIMO_JOURNEY_PORT=6224
# Days of nightly pg_dump backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# ─── Resilience / health ──────────────────────────────────────
# Connectivity probe; network down → CoSiMo auto-switches to offline canned mode.
HEALTH_PING_URL=https://www.gstatic.com/generate_204
HEALTH_INTERVAL_MS=15000

# ─── Tailnet (optional, docker-compose.tailnet.yml) ───────────
# Puts ONLY the realtime container on the Tailscale tailnet (a sidecar owns
# its network namespace) so it can reach the GX10's vLLM. Nothing else on the
# VPS joins. Use a TAGGED auth key (tag:cosimo) so the node never inherits a
# person's key expiry; disable key expiry on the node after it joins.
TS_AUTHKEY=
TS_HOSTNAME=cosimo-vps
TS_TAG=tag:cosimo-vps

# ─── Debug log ────────────────────────────────────────────────
# Structured per-turn log (tools, actuations, timings, errors): ring buffer
# + live stream to the console + daily NDJSON files. See docs/logging.md.
LOG_DIR=logs
LOG_KEEP_DAYS=14
LOG_BUFFER=5000
# The one GDPR switch: false blanks visitor/CoSiMo text everywhere in the
# debug log (mechanical events stay). On for the dev phase by decision.
LOG_TRANSCRIPTS=true

# ─── Cabin hardware ───────────────────────────────────────────
# Shelly relay on the local LAN (Phase 2). Leave blank to use the fake driver.
# Only usable when the realtime service itself sits on the cabin network.
SHELLY_BASE_URL=
LIGHT_DRIVER=fake

# Cuety LPU-2 DMX controller on the (air-gapped) cabin LAN. The KIOSKS call
# it, not this service — so this is the address as the iPads see it, and it
# works with the hub on the VPS. Normally set in the CMS (operator-config →
# Kabine) instead; this is the fallback default. Blank = light stays simulated.
LPU2_BASE_URL=
LPU2_TIMEOUT_MS=2500
